  createdBy      User                    @relation("ProjectMemberCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User                    @relation("ProjectMemberUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([projectId, membershipId])
  @@unique([projectId, employeeId])
  @@index([organizationId, projectId, deletedAt])
  @@index([organizationId, membershipId, deletedAt])
}

model Employee {
  id                 String                  @id @default(uuid()) @db.Uuid
  organizationId     String                  @db.Uuid
  linkedUserId       String?                 @db.Uuid
  managerId          String?                 @db.Uuid
  employeeNumber     String
  firstName          String
  lastName           String?
  workEmail          String?
  workPhone          String?
  jobTitle           String
  department         String?
  employmentType     EmploymentType
  status             EmployeeStatus          @default(ACTIVE)
  startDate          DateTime
  endDate            DateTime?
  createdById        String                  @db.Uuid
  updatedById        String                  @db.Uuid
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  deletedAt          DateTime?
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  linkedUser         User?                   @relation("EmployeeLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  manager            Employee?               @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports      Employee[]              @relation("EmployeeManager")
  projectAssignments ProjectMember[]
  assignedTickets    SupportTicket[]
