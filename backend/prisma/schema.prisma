model User {
  id                          String                        @id @default(uuid()) @db.Uuid
  firstName                   String
  lastName                    String?
  email                       String                        @unique
  passwordHash                String
  status                      UserStatus                    @default(ACTIVE)
  emailVerifiedAt             DateTime?
  lastLoginAt                 DateTime?
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  deletedAt                   DateTime?
  isPlatformAdmin             Boolean                       @default(false)
  memberships                 OrganizationMembership[]
  refreshSessions             RefreshSession[]
  invitationsSent             MembershipInvitation[]        @relation("InvitationSender")
  organizationServicesCreated OrganizationService[]         @relation("OrganizationServiceCreatedBy")
  organizationServicesUpdated OrganizationService[]         @relation("OrganizationServiceUpdatedBy")
  servicePlansCreated         ServicePlan[]                 @relation("ServicePlanCreatedBy")
  servicePlansUpdated         ServicePlan[]                 @relation("ServicePlanUpdatedBy")
  organizationPlansAssigned   OrganizationPlan[]            @relation("OrganizationPlanAssignedBy")
  organizationPlansUpdated    OrganizationPlan[]            @relation("OrganizationPlanUpdatedBy")
  subscriptionPaymentsCreated SubscriptionPayment[]         @relation("SubscriptionPaymentCreatedBy")
  serviceOverridesCreated     OrganizationServiceOverride[] @relation("ServiceOverrideCreatedBy")
  entitlementsCreated         Entitlement[]                 @relation("EntitlementCreatedBy")
  entitlementsUpdated         Entitlement[]                 @relation("EntitlementUpdatedBy")
  platformInvitationsSent     PlatformInvitation[]          @relation("PlatformInvitationSender")
  customersCreated            Customer[]                    @relation("CustomerCreatedBy")
  customersUpdated            Customer[]                    @relation("CustomerUpdatedBy")
  customerActivitiesCreated   CustomerActivity[]            @relation("CustomerActivityCreatedBy")
  customerActivitiesUpdated   CustomerActivity[]            @relation("CustomerActivityUpdatedBy")
  followUpsAssigned           CustomerFollowUp[]            @relation("FollowUpAssignedTo")
  followUpsCreated            CustomerFollowUp[]            @relation("FollowUpCreatedBy")
  followUpsUpdated            CustomerFollowUp[]            @relation("FollowUpUpdatedBy")
  notifications               Notification[]                @relation("NotificationRecipient")
  notificationsCreated        Notification[]                @relation("NotificationCreatedBy")
  notificationsUpdated        Notification[]                @relation("NotificationUpdatedBy")
  agentsCreated               AgentDefinition[]             @relation("AgentCreatedBy")
  agentsUpdated               AgentDefinition[]             @relation("AgentUpdatedBy")
  agentRunsInitiated          AgentRun[]                    @relation("AgentRunInitiatedBy")
  voiceCallsCreated           VoiceCallJob[]                @relation("VoiceCallCreatedBy")
  voiceCallsUpdated           VoiceCallJob[]                @relation("VoiceCallUpdatedBy")
  voiceCallsApproved          VoiceCallJob[]                @relation("VoiceCallApprovedBy")
  approvalsRequested          ApprovalRequest[]             @relation("ApprovalRequestedBy")
  approvalsDecided            ApprovalRequest[]             @relation("ApprovalDecidedBy")
  auditEvents                 AuditEvent[]                  @relation("AuditActorUser")
  recommendationsDecided      BusinessRecommendation[]      @relation("RecommendationDecidedBy")
  projectsOwned               Project[]                     @relation("ProjectOwner")
  projectsCreated             Project[]                     @relation("ProjectCreatedBy")
  projectsUpdated             Project[]                     @relation("ProjectUpdatedBy")
  tasksAssigned               ProjectTask[]                 @relation("TaskAssignedTo")
  tasksCreated                ProjectTask[]                 @relation("TaskCreatedBy")
  tasksUpdated                ProjectTask[]                 @relation("TaskUpdatedBy")
  projectMembersCreated       ProjectMember[]               @relation("ProjectMemberCreatedBy")
  projectMembersUpdated       ProjectMember[]               @relation("ProjectMemberUpdatedBy")
  employeeProfiles            Employee[]                    @relation("EmployeeLinkedUser")
  employeesCreated            Employee[]                    @relation("EmployeeCreatedBy")
  employeesUpdated            Employee[]                    @relation("EmployeeUpdatedBy")
  dealsOwned                  Deal[]                        @relation("DealOwner")
  dealsCreated                Deal[]                        @relation("DealCreatedBy")
  dealsUpdated                Deal[]                        @relation("DealUpdatedBy")
  invoicesCreated             Invoice[]                     @relation("InvoiceCreatedBy")
  invoicesUpdated             Invoice[]                     @relation("InvoiceUpdatedBy")
  paymentsCreated             Payment[]                     @relation("PaymentCreatedBy")
  expensesCreated             Expense[]                     @relation("ExpenseCreatedBy")
  expensesUpdated             Expense[]                     @relation("ExpenseUpdatedBy")
  catalogueItemsCreated       CatalogueItem[]               @relation("CatalogueItemCreatedBy")
  catalogueItemsUpdated       CatalogueItem[]               @relation("CatalogueItemUpdatedBy")
  ordersCreated               Order[]                       @relation("OrderCreatedBy")
  ordersUpdated               Order[]                       @relation("OrderUpdatedBy")
  warehousesCreated           Warehouse[]                   @relation("WarehouseCreatedBy")
  warehousesUpdated           Warehouse[]                   @relation("WarehouseUpdatedBy")
  stockMovementsCreated       StockMovement[]               @relation("StockMovementCreatedBy")
  campaignsCreated            MarketingCampaign[]           @relation("CampaignCreatedBy")
  campaignsUpdated            MarketingCampaign[]           @relation("CampaignUpdatedBy")
  campaignLeadsCreated        CampaignLead[]                @relation("CampaignLeadCreatedBy")
  ticketsCreated              SupportTicket[]               @relation("TicketCreatedBy")
  ticketsUpdated              SupportTicket[]               @relation("TicketUpdatedBy")
  ticketMessagesCreated       TicketMessage[]               @relation("TicketMessageCreatedBy")
  ticketAttachmentsCreated    TicketAttachment[]            @relation("TicketAttachmentCreatedBy")
  websitesCreated             ManagedWebsite[]              @relation("WebsiteCreatedBy")
  websitesUpdated             ManagedWebsite[]              @relation("WebsiteUpdatedBy")
  websiteRequestsCreated      WebsiteChangeRequest[]        @relation("WebsiteRequestCreatedBy")
  websiteRequestsUpdated      WebsiteChangeRequest[]        @relation("WebsiteRequestUpdatedBy")
  websiteRequestsApproved     WebsiteChangeRequest[]        @relation("WebsiteRequestApprovedBy")
  deploymentsCreated          WebsiteDeployment[]           @relation("DeploymentCreatedBy")
  vendorsCreated              Vendor[]                      @relation("VendorCreatedBy")
  vendorsUpdated              Vendor[]                      @relation("VendorUpdatedBy")
  purchaseOrdersCreated       PurchaseOrder[]               @relation("PurchaseOrderCreatedBy")
  purchaseOrdersUpdated       PurchaseOrder[]               @relation("PurchaseOrderUpdatedBy")
  purchaseOrdersApproved      PurchaseOrder[]               @relation("PurchaseOrderApprovedBy")
  goodsReceiptsCreated        GoodsReceipt[]                @relation("GoodsReceiptCreatedBy")
  calendarEventsCreated       CalendarEvent[]               @relation("CalendarEventCreatedBy")
  calendarEventsUpdated       CalendarEvent[]               @relation("CalendarEventUpdatedBy")
  inquiriesCreated            Inquiry[]                     @relation("InquiryCreatedBy")
  inquiriesUpdated            Inquiry[]                     @relation("InquiryUpdatedBy")
  inquiryTimelineCreated      InquiryTimeline[]             @relation("InquiryTimelineCreatedBy")
  leadAssignmentsCreated      LeadAssignmentHistory[]       @relation("LeadAssignmentActor")
  connectorsCreated           IntegrationConnector[]        @relation("ConnectorCreatedBy")
  connectorsUpdated           IntegrationConnector[]        @relation("ConnectorUpdatedBy")
  integrationEventsCreated    IntegrationEvent[]            @relation("IntegrationEventCreatedBy")
  integrationEventsUpdated    IntegrationEvent[]            @relation("IntegrationEventUpdatedBy")
  automationAttemptsCreated   AutomationAttempt[]           @relation("AutomationAttemptCreatedBy")
  messageDraftsCreated        AutomationMessageDraft[]      @relation("MessageDraftCreatedBy")
  messageDraftsUpdated        AutomationMessageDraft[]      @relation("MessageDraftUpdatedBy")
  messageDraftsApproved       AutomationMessageDraft[]      @relation("MessageDraftApprovedBy")
  stayRecordsCreated          StayProperty[]                @relation("StayPropertyCreatedBy")
  stayRecordsUpdated          StayProperty[]                @relation("StayPropertyUpdatedBy")
  stayResidentsCreated        StayResident[]                @relation("StayResidentCreatedBy")
  stayResidentsUpdated        StayResident[]                @relation("StayResidentUpdatedBy")
  stayOccupanciesCreated      StayOccupancy[]               @relation("StayOccupancyCreatedBy")
  stayRentChargesCreated      StayRentCharge[]              @relation("StayRentChargeCreatedBy")
  stayPaymentsCreated         StayRentPayment[]             @relation("StayRentPaymentCreatedBy")

  @@index([status, deletedAt])
}

model Organization {
  id                      String                        @id @default(uuid()) @db.Uuid
  name                    String
  slug                    String                        @unique
  status                  OrganizationStatus            @default(ACTIVE)
  timezone                String                        @default("Asia/Kolkata")
  currency                String                        @default("INR")
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  deletedAt               DateTime?
  memberships             OrganizationMembership[]
  roles                   Role[]
  invitations             MembershipInvitation[]
  organizationServices    OrganizationService[]
  organizationPlan        OrganizationPlan?
  subscriptionPayments    SubscriptionPayment[]
  serviceOverrides        OrganizationServiceOverride[]
  entitlements            Entitlement[]
  platformInvitations     PlatformInvitation[]
  customers               Customer[]
  customerActivities      CustomerActivity[]
  customerFollowUps       CustomerFollowUp[]
  notifications           Notification[]
  agents                  AgentDefinition[]
  agentRuns               AgentRun[]
  voiceCallJobs           VoiceCallJob[]
  approvalRequests        ApprovalRequest[]
  auditEvents             AuditEvent[]
  businessRecommendations BusinessRecommendation[]
  projects                Project[]
  projectTasks            ProjectTask[]
  projectMembers          ProjectMember[]
  employees               Employee[]
  deals                   Deal[]
  invoices                Invoice[]
  payments                Payment[]
  expenses                Expense[]
  catalogueItems          CatalogueItem[]
  orders                  Order[]
  warehouses              Warehouse[]
  stockLevels             StockLevel[]
  stockMovements          StockMovement[]
  stockReservations       StockReservation[]
  marketingCampaigns      MarketingCampaign[]
  campaignLeads           CampaignLead[]
  supportTickets          SupportTicket[]
  ticketMessages          TicketMessage[]
  ticketAttachments       TicketAttachment[]
  managedWebsites         ManagedWebsite[]
  websiteRequests         WebsiteChangeRequest[]
  websiteDeployments      WebsiteDeployment[]
  vendors                 Vendor[]
  purchaseOrders          PurchaseOrder[]
  goodsReceipts           GoodsReceipt[]
  calendarEvents          CalendarEvent[]
  calendarAttendees       CalendarEventAttendee[]
  calendarReminders       CalendarReminder[]
  inquiries               Inquiry[]
  inquiryTimeline         InquiryTimeline[]
  leadAssignmentRules     LeadAssignmentRule[]
  leadAssignmentHistory   LeadAssignmentHistory[]
  followUpSequences       FollowUpSequence[]
  followUpEnrollments     FollowUpEnrollment[]
  followUpExecutions      FollowUpExecution[]
  integrationConnectors   IntegrationConnector[]
  integrationEvents       IntegrationEvent[]
  automationAttempts      AutomationAttempt[]
  automationMessageDrafts AutomationMessageDraft[]
  stayProperties          StayProperty[]
  stayRooms               StayRoom[]
  stayBeds                StayBed[]
  stayResidents           StayResident[]
  stayOccupancies         StayOccupancy[]
  stayRentCharges         StayRentCharge[]
  stayRentPayments        StayRentPayment[]

  @@index([status, deletedAt])
