  assignedTo     User           @relation("FollowUpAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdBy      User           @relation("FollowUpCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User           @relation("FollowUpUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  voiceCallJobs  VoiceCallJob[]

  @@index([organizationId, customerId, status, deletedAt, dueAt])
  @@index([organizationId, assignedToId, status, dueAt])
  @@index([createdById])
  @@index([updatedById])
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  recipientId    String           @db.Uuid
  type           NotificationType
  title          String
  message        String
  sourceType     String?
  sourceId       String?          @db.Uuid
  actionPath     String?
  availableAt    DateTime         @default(now())
  readAt         DateTime?
  createdById    String           @db.Uuid
  updatedById    String           @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipient      User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  createdBy      User             @relation("NotificationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User             @relation("NotificationUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, recipientId, sourceType, sourceId])
  @@index([organizationId, recipientId, deletedAt, availableAt])
  @@index([organizationId, recipientId, readAt, availableAt])
  @@index([createdById])
  @@index([updatedById])
}

model AgentDefinition {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @db.Uuid
  name              String
  purpose           String
  instructions      String?
  supportedService  String
  status            AgentStatus    @default(DRAFT)
  requiresApproval  Boolean        @default(true)
  allowedActions    Json
  dailyRunLimit     Int            @default(10)
  dailyContactLimit Int            @default(0)
  createdById       String         @db.Uuid
  updatedById       String         @db.Uuid
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy         User           @relation("AgentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy         User           @relation("AgentUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  runs              AgentRun[]
  voiceCallJobs     VoiceCallJob[]

  @@index([organizationId, status, deletedAt])
  @@index([createdById])
  @@index([updatedById])
}

model AgentRun {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  agentId        String          @db.Uuid
  status         AgentRunStatus  @default(QUEUED)
  triggerType    String
  summary        String?
  errorMessage   String?
  initiatedById  String          @db.Uuid
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent          AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Cascade)
  initiatedBy    User            @relation("AgentRunInitiatedBy", fields: [initiatedById], references: [id], onDelete: Restrict)

  @@index([organizationId, agentId, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([initiatedById])
}

model VoiceCallJob {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  agentId        String            @db.Uuid
  customerId     String            @db.Uuid
  followUpId     String?           @db.Uuid
  phoneNumber    String
  language       String            @default("en-IN")
  objective      String
  approvedScript String
  status         VoiceCallStatus   @default(PENDING_APPROVAL)
  outcome        VoiceCallOutcome?
  outcomeSummary String?
  transcript     String?
  recordingUrl   String?
  provider       String?
  providerCallId String?
  scheduledAt    DateTime?
  approvedById   String?           @db.Uuid
  approvedAt     DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  failureMessage String?
  createdById    String            @db.Uuid
  updatedById    String            @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent          AgentDefinition   @relation(fields: [agentId], references: [id], onDelete: Restrict)
  customer       Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  followUp       CustomerFollowUp? @relation(fields: [followUpId], references: [id], onDelete: SetNull)
  approvedBy     User?             @relation("VoiceCallApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  createdBy      User              @relation("VoiceCallCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User              @relation("VoiceCallUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status, scheduledAt])
  @@index([organizationId, customerId, createdAt])
  @@index([organizationId, followUpId])
  @@index([agentId])
  @@index([createdById])
  @@index([updatedById])
}

model ApprovalRequest {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  serviceCode    String
  actionCode     String
  title          String
  description    String?
  riskLevel      ApprovalRiskLevel @default(MEDIUM)
  status         ApprovalStatus    @default(PENDING)
  sourceType     String
  sourceId       String            @db.Uuid
  requestedById  String            @db.Uuid
  decidedById    String?           @db.Uuid
  decisionNote   String?
  dueAt          DateTime?
  decidedAt      DateTime?
  context        Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy    User              @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy      User?             @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, sourceType, sourceId])
  @@index([organizationId, status, dueAt, createdAt])
  @@index([organizationId, serviceCode, riskLevel, createdAt])
  @@index([requestedById])
  @@index([decidedById])
}

model AuditEvent {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  actorType      AuditActorType
  actorUserId    String?        @db.Uuid
  serviceCode    String
  actionCode     String
  sourceType     String
  sourceId       String?        @db.Uuid
  summary        String
  beforeState    Json?
  afterState     Json?
  metadata       Json?
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorUser      User?          @relation("AuditActorUser", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, serviceCode, actionCode, createdAt])
  @@index([organizationId, sourceType, sourceId, createdAt])
  @@index([actorUserId])
}

model BusinessRecommendation {
  id                String                       @id @default(uuid()) @db.Uuid
  organizationId    String                       @db.Uuid
  fingerprint       String
  serviceCode       String
  actionCode        String
  sourceType        String
  sourceId          String                       @db.Uuid
  title             String
  explanation       String
  recommendedAction String
  impactSummary     String?
  priority          ApprovalRiskLevel            @default(MEDIUM)
  status            BusinessRecommendationStatus @default(OPEN)
  evidence          Json
  decidedById       String?                      @db.Uuid
  decisionNote      String?
  decidedAt         DateTime?
  executedAt        DateTime?
  resolvedAt        DateTime?
  lastDetectedAt    DateTime                     @default(now())
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  decidedBy         User?                        @relation("RecommendationDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, fingerprint])
  @@index([organizationId, status, priority, createdAt])
  @@index([organizationId, serviceCode, status])
  @@index([decidedById])
}

model Project {
  id              String                 @id @default(uuid()) @db.Uuid
  organizationId  String                 @db.Uuid
  customerId      String?                @db.Uuid
  name            String
  code            String
  description     String?
  status          ProjectStatus          @default(PLANNING)
  priority        ProjectPriority        @default(MEDIUM)
  startDate       DateTime?
  dueDate         DateTime?
  completedAt     DateTime?
  ownerId         String                 @db.Uuid
  createdById     String                 @db.Uuid
  updatedById     String                 @db.Uuid
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  owner           User                   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy       User                   @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User                   @relation("ProjectUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  tasks           ProjectTask[]
  members         ProjectMember[]
  websiteRequests WebsiteChangeRequest[]
  calendarEvents  CalendarEvent[]
  invoices        Invoice[]
  expenses        Expense[]

  @@unique([organizationId, code])
  @@index([organizationId, status, deletedAt, dueDate])
  @@index([organizationId, customerId, deletedAt])
  @@index([ownerId])
}

model ProjectTask {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  projectId      String       @db.Uuid
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  assignedToId   String?      @db.Uuid
  dueDate        DateTime?
  completedAt    DateTime?
  createdById    String       @db.Uuid
  updatedById    String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo     User?        @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy      User         @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User         @relation("TaskUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([organizationId, projectId, status, deletedAt, dueDate])
  @@index([organizationId, assignedToId, status, dueDate])
  @@index([createdById])
}

model ProjectMember {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  projectId      String                  @db.Uuid
  membershipId   String?                 @db.Uuid
  employeeId     String?                 @db.Uuid
  role           ProjectMemberRole       @default(CONTRIBUTOR)
  roleLabel      String?
  createdById    String                  @db.Uuid
  updatedById    String                  @db.Uuid
