  @@index([organizationId, stage, deletedAt, expectedCloseDate])
  @@index([organizationId, customerId, deletedAt])
  @@index([organizationId, ownerId, stage])
}

model Invoice {
  id             String            @id @default(uuid()) @db.Uuid
