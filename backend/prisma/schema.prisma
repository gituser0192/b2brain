model OrganizationMembership {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @db.Uuid
  userId             String           @db.Uuid
  roleId             String           @db.Uuid
  status             MembershipStatus @default(ACTIVE)
  joinedAt           DateTime         @default(now())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user               User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  role               Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  refreshSessions    RefreshSession[]
  projectAssignments ProjectMember[]

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, status])
  @@index([roleId])
}

model Role {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String?                  @db.Uuid
  code           String
  name           String
  description    String?
  isSystem       Boolean                  @default(false)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  organization   Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    OrganizationMembership[]
  permissions    RolePermission[]
  invitations    MembershipInvitation[]

  @@unique([organizationId, code])
  @@index([code, isSystem])
}

model MembershipInvitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  email          String
  roleId         String           @db.Uuid
  invitedById    String           @db.Uuid
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy      User             @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([email, status])
  @@index([roleId])
  @@index([invitedById])
  @@index([expiresAt])
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  name        String
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshSession {
  id                  String                 @id @default(uuid()) @db.Uuid
  userId              String                 @db.Uuid
  membershipId        String                 @db.Uuid
  tokenHash           String                 @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedBySessionId String?                @db.Uuid
  userAgent           String?
  ipAddress           String?
  createdAt           DateTime               @default(now())
  lastUsedAt          DateTime?
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership          OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  replacedBySession   RefreshSession?        @relation("SessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replaces            RefreshSession[]       @relation("SessionReplacement")

  @@index([userId, revokedAt])
  @@index([membershipId])
  @@index([expiresAt])
}

model Service {
  id                    String                        @id @default(uuid()) @db.Uuid
  code                  String                        @unique
  name                  String
  description           String?
  status                ServiceStatus                 @default(DRAFT)
  iconKey               String?
  routePath             String?
  sortOrder             Int                           @default(0)
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  archivedAt            DateTime?
  organizationServices  OrganizationService[]
  featureFlags          FeatureFlag[]
  entitlements          Entitlement[]
  planItems             ServicePlanItem[]
  organizationOverrides OrganizationServiceOverride[]

  @@index([status, sortOrder])
}

model ServicePlan {
  id            String             @id @default(uuid()) @db.Uuid
  code          String             @unique
  name          String
  description   String?
  status        ServicePlanStatus  @default(DRAFT)
  monthlyPrice  Decimal            @default(0) @db.Decimal(12, 2)
  yearlyPrice   Decimal            @default(0) @db.Decimal(12, 2)
  currency      String             @default("INR")
  createdById   String             @db.Uuid
  updatedById   String             @db.Uuid
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  archivedAt    DateTime?
  createdBy     User               @relation("ServicePlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy     User               @relation("ServicePlanUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  services      ServicePlanItem[]
  organizations OrganizationPlan[]

  @@index([status, name])
  @@index([createdById])
  @@index([updatedById])
}

model ServicePlanItem {
  id        String      @id @default(uuid()) @db.Uuid
  planId    String      @db.Uuid
  serviceId String      @db.Uuid
  createdAt DateTime    @default(now())
  plan      ServicePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  service   Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([planId, serviceId])
  @@index([serviceId])
}

model OrganizationPlan {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @unique @db.Uuid
  planId         String                 @db.Uuid
  status         OrganizationPlanStatus
  billingCycle   BillingCycle           @default(MONTHLY)
  amount         Decimal                @default(0) @db.Decimal(12, 2)
  currency       String                 @default("INR")
  nextBillingAt  DateTime?
  pastDueAt      DateTime?
  startsAt       DateTime               @default(now())
  trialEndsAt    DateTime?
  expiresAt      DateTime?
  assignedById   String                 @db.Uuid
  updatedById    String                 @db.Uuid
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan           ServicePlan            @relation(fields: [planId], references: [id], onDelete: Restrict)
  assignedBy     User                   @relation("OrganizationPlanAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  updatedBy      User                   @relation("OrganizationPlanUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  payments       SubscriptionPayment[]

  @@index([planId, status])
  @@index([status, trialEndsAt, expiresAt])
  @@index([assignedById])
  @@index([updatedById])
}

model SubscriptionPayment {
  id                 String                    @id @default(uuid()) @db.Uuid
  organizationId     String                    @db.Uuid
  organizationPlanId String                    @db.Uuid
  amount             Decimal                   @db.Decimal(12, 2)
  currency           String                    @default("INR")
  status             SubscriptionPaymentStatus @default(PAID)
  paidAt             DateTime
  periodStartsAt     DateTime
  periodEndsAt       DateTime
  reference          String?
  note               String?
  createdById        String                    @db.Uuid
  createdAt          DateTime                  @default(now())
  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationPlan   OrganizationPlan          @relation(fields: [organizationPlanId], references: [id], onDelete: Cascade)
  createdBy          User                      @relation("SubscriptionPaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organizationId, paidAt])
  @@index([organizationPlanId, paidAt])
  @@index([createdById])
}

model OrganizationServiceOverride {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  serviceId      String              @db.Uuid
  type           ServiceOverrideType
  createdById    String              @db.Uuid
  createdAt      DateTime            @default(now())
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service        Service             @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  createdBy      User                @relation("ServiceOverrideCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([organizationId, serviceId])
  @@index([serviceId, type])
  @@index([createdById])
}

model OrganizationService {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @db.Uuid
  serviceId      String                    @db.Uuid
  status         OrganizationServiceStatus @default(ENABLED)
  createdById    String                    @db.Uuid
  updatedById    String                    @db.Uuid
  enabledAt      DateTime                  @default(now())
  disabledAt     DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  deletedAt      DateTime?
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service        Service                   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  createdBy      User                      @relation("OrganizationServiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User                      @relation("OrganizationServiceUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, serviceId])
  @@index([organizationId, status, deletedAt])
  @@index([serviceId])
  @@index([createdById])
  @@index([updatedById])
}

model FeatureFlag {
  id           String        @id @default(uuid()) @db.Uuid
  serviceId    String        @db.Uuid
  code         String
  name         String
  description  String?
  defaultOn    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  entitlements Entitlement[]

  @@unique([serviceId, code])
  @@index([code])
}

model Entitlement {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  serviceId      String       @db.Uuid
  featureFlagId  String?      @db.Uuid
  key            String
  enabled        Boolean      @default(true)
  limits         Json?
  createdById    String       @db.Uuid
  updatedById    String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  featureFlag    FeatureFlag? @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("EntitlementCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User         @relation("EntitlementUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, serviceId, key])
  @@index([organizationId, enabled, deletedAt])
  @@index([serviceId])
  @@index([featureFlagId])
  @@index([createdById])
  @@index([updatedById])
}

model PlatformInvitation {
  id               String                 @id @default(uuid()) @db.Uuid
  email            String
  organizationName String
  organizationId   String?                @db.Uuid
  type             PlatformInvitationType @default(NEW_ORGANIZATION)
  tokenHash        String                 @unique
  status           InvitationStatus       @default(PENDING)
  invitedById      String                 @db.Uuid
  expiresAt        DateTime
  acceptedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  invitedBy        User                   @relation("PlatformInvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  organization     Organization?          @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([email, status])
  @@index([status, expiresAt])
  @@index([invitedById])
  @@index([organizationId])
}

model Customer {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @db.Uuid
  type            CustomerType
  displayName     String
  firstName       String?
  lastName        String?
  companyName     String?
  email           String?
  phone           String?
  website         String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  postalCode      String?
  country         String?
  status          CustomerStatus     @default(LEAD)
  notes           String?
  createdById     String             @db.Uuid
  updatedById     String             @db.Uuid
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User               @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User               @relation("CustomerUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  activities      CustomerActivity[]
  followUps       CustomerFollowUp[]
  voiceCallJobs   VoiceCallJob[]
  projects        Project[]
  deals           Deal[]
  invoices        Invoice[]
  orders          Order[]
  campaignLeads   CampaignLead[]
  supportTickets  SupportTicket[]
  managedWebsites ManagedWebsite[]
  calendarEvents  CalendarEvent[]
  inquiries       Inquiry[]

  @@index([organizationId, deletedAt, createdAt])
  @@index([organizationId, status, deletedAt])
  @@index([organizationId, displayName])
  @@index([createdById])
  @@index([updatedById])
}

model CustomerActivity {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  customerId     String               @db.Uuid
  type           CustomerActivityType
  summary        String
  details        String?
  occurredAt     DateTime             @default(now())
  createdById    String               @db.Uuid
  updatedById    String               @db.Uuid
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy      User                 @relation("CustomerActivityCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User                 @relation("CustomerActivityUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([organizationId, customerId, deletedAt, occurredAt])
  @@index([createdById])
  @@index([updatedById])
}

model CustomerFollowUp {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  customerId     String         @db.Uuid
  title          String
  description    String?
  dueAt          DateTime
  status         FollowUpStatus @default(PENDING)
  assignedToId   String         @db.Uuid
  createdById    String         @db.Uuid
  updatedById    String         @db.Uuid
  completedAt    DateTime?
