  updatedBy          User                    @relation("EmployeeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@unique([organizationId, employeeNumber])
  @@unique([organizationId, linkedUserId])
  @@index([organizationId, status, deletedAt])
  @@index([organizationId, department, deletedAt])
  @@index([organizationId, managerId, deletedAt])
  @@index([createdById])
  @@index([updatedById])
}

model Deal {
  id                 String          @id @default(uuid()) @db.Uuid
  organizationId     String          @db.Uuid
  customerId         String          @db.Uuid
  name               String
  stage              DealStage       @default(PROSPECTING)
  amount             Decimal         @db.Decimal(18, 2)
  currency           String
  probability        Int
  expectedCloseDate  DateTime?
  closedAt           DateTime?
  lostReason         String?
  notes              String?
  ownerId            String          @db.Uuid
  createdById        String          @db.Uuid
  updatedById        String          @db.Uuid
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
