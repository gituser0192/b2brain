NODE_ENV=production
PORT=10000
FRONTEND_URL=https://your-vercel-project.vercel.app
TRUST_PROXY=true
DATABASE_URL=postgresql://USER:PASSWORD@NEON-POOLED-HOST/DATABASE?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://USER:PASSWORD@NEON-DIRECT-HOST/DATABASE?sslmode=require&channel_binding=require
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_RANDOM_SECRET
REFRESH_TOKEN_EXPIRES_IN=30d
COOKIE_NAME=b2brain_refresh
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
COOKIE_DOMAIN=
PASSWORD_HASH_COST=12
SUPER_ADMIN_EMAIL=owner@example.com
BRIDGE_ENCRYPTION_KEY=REPLACE_WITH_A_STRONG_RANDOM_ENCRYPTION_KEY
META_WHATSAPP_ENABLED=false
META_WHATSAPP_OUTBOUND_ENABLED=false
META_WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_A_RANDOM_WEBHOOK_VERIFY_TOKEN
META_WHATSAPP_APP_SECRET=REPLACE_WITH_META_APP_SECRET
META_WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_META_TEST_ACCESS_TOKEN
META_WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_META_TEST_PHONE_NUMBER_ID
META_WHATSAPP_BUSINESS_ACCOUNT_ID=REPLACE_WITH_META_TEST_WABA_ID
META_WHATSAPP_ALLOWED_TEST_RECIPIENTS=919999999999
META_WHATSAPP_WEBHOOK_TIMEOUT_MS=10000
META_WHATSAPP_PROVIDER_TIMEOUT_MS=10000
META_WHATSAPP_MAX_RETRIES=2
META_GRAPH_API_VERSION=v23.0
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=SMTP_ACCOUNT_USERNAME
SMTP_PASSWORD=SMTP_ACCOUNT_PASSWORD
EMAIL_FROM=B2 Brain <no-reply@yourdomain.com>
ENQUIRY_AI_MODE=deterministic
ENQUIRY_AI_KILL_SWITCH=false
ENQUIRY_AI_BASE_URL=https://api.openai.com/v1
ENQUIRY_AI_MODEL=YOUR_STRUCTURED_OUTPUT_MODEL
OPENAI_API_KEY=YOUR_HOSTED_PROVIDER_API_KEY
ENQUIRY_AI_TIMEOUT_MS=12000
ENQUIRY_AI_MAX_RETRIES=1
ENQUIRY_AI_MAX_OUTPUT_TOKENS=700
ENQUIRY_AI_DAILY_REQUEST_LIMIT=100
