NODE_ENV=production
PORT=10000
FRONTEND_URL=https://your-vercel-project.vercel.app
# Optional second browser origin; set to https://sathos.in on staging Render.
# Keep FRONTEND_URL as the staging URL for invitation and reset links.
ADDITIONAL_FRONTEND_ORIGIN=
TRUST_PROXY=true
EXTERNAL_CHANNELS_ENABLED=false
JSON_BODY_LIMIT=1mb
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=1000
DATABASE_URL=postgresql://USER:PASSWORD@NEON-POOLED-HOST/DATABASE?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://USER:PASSWORD@NEON-DIRECT-HOST/DATABASE?sslmode=require&channel_binding=require
JWT_ACCESS_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=REPLACE_WITH_A_DIFFERENT_32_CHARACTER_RANDOM_SECRET
REFRESH_TOKEN_EXPIRES_IN=30d
COOKIE_NAME=b2brain_refresh
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
COOKIE_DOMAIN=
PASSWORD_HASH_COST=12
SUPER_ADMIN_EMAIL=owner@example.com
BRIDGE_ENCRYPTION_KEY=REPLACE_WITH_A_STRONG_RANDOM_ENCRYPTION_KEY
META_WHATSAPP_ENABLED=false
META_WHATSAPP_OUTBOUND_ENABLED=false
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_ALLOWED_TEST_RECIPIENTS=
META_WHATSAPP_WEBHOOK_TIMEOUT_MS=10000
META_WHATSAPP_PROVIDER_TIMEOUT_MS=10000
META_WHATSAPP_MAX_RETRIES=2
META_GRAPH_API_VERSION=v23.0
META_LEAD_ADS_ENABLED=false
META_LEAD_GRAPH_ENABLED=false
META_LEAD_VERIFY_TOKEN=
META_LEAD_APP_SECRET=
META_LEAD_GRAPH_BASE_URL=https://graph.facebook.com
META_LEAD_GRAPH_TIMEOUT_MS=10000
META_LEAD_GRAPH_MAX_RETRIES=1
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=SMTP_ACCOUNT_USERNAME
SMTP_PASSWORD=SMTP_ACCOUNT_PASSWORD
EMAIL_FROM=SATHOS <no-reply@yourdomain.com>
ENQUIRY_AI_MODE=deterministic
ENQUIRY_AI_KILL_SWITCH=true
ENQUIRY_AI_BASE_URL=https://api.openai.com/v1
ENQUIRY_AI_MODEL=YOUR_STRUCTURED_OUTPUT_MODEL
OPENAI_API_KEY=YOUR_HOSTED_PROVIDER_API_KEY
ENQUIRY_AI_TIMEOUT_MS=12000
ENQUIRY_AI_MAX_RETRIES=1
ENQUIRY_AI_MAX_OUTPUT_TOKENS=700
ENQUIRY_AI_DAILY_REQUEST_LIMIT=100
WORKSPACE_AI_PROVIDER=disabled
WORKSPACE_AI_KILL_SWITCH=true
WORKSPACE_AI_DETERMINISTIC_ONLY=true
WORKSPACE_AI_MODEL=YOUR_STRUCTURED_OUTPUT_MODEL
WORKSPACE_AI_BASE_URL=https://api.openai.com/v1
WORKSPACE_AI_TIMEOUT_MS=12000
WORKSPACE_AI_MAX_RETRIES=1
WORKSPACE_AI_MAX_INPUT_CHARS=12000
WORKSPACE_AI_MAX_OUTPUT_TOKENS=700
WORKSPACE_AI_DAILY_TOKEN_LIMIT=100000
WORKSPACE_AI_MONTHLY_TOKEN_LIMIT=1000000
WORKSPACE_AI_DAILY_REQUEST_LIMIT=100
WORKSPACE_AI_MAX_TOOL_ITERATIONS=1
WORKSPACE_AI_CIRCUIT_FAILURE_THRESHOLD=3
WORKSPACE_AI_CIRCUIT_RESET_MS=60000
WORKSPACE_AI_INPUT_COST_PER_MILLION_USD=0
WORKSPACE_AI_OUTPUT_COST_PER_MILLION_USD=0
PUBLIC_INFORMATION_TOOLS_ENABLED=false

# Optional internal reasoning service. Existing TypeScript remains default.
WORKSPACE_AGENT_REASONING_BACKEND=typescript
PYTHON_AGENT_ENABLED=false
# Set only when enabling Python; never use an actual secret in this example.
# PYTHON_AGENT_SERVICE_URL=http://127.0.0.1:8000
# PYTHON_AGENT_SERVICE_SECRET=REPLACE_WITH_RANDOM_SERVICE_SECRET
PYTHON_AGENT_TIMEOUT_MS=15000
PYTHON_AGENT_MAX_ITERATIONS=1
